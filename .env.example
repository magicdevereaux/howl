# Database
DATABASE_URL=postgresql://howl:howl_dev@127.0.0.1:5433/howl

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — optional; enables DALL-E avatar image generation
OPENAI_API_KEY=sk-proj-...

# Cloudflare R2 — optional; enables persistent avatar storage (recommended for production)
# Without these, avatars are stored on the local filesystem and lost on Railway redeploys.
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=howl-avatars
R2_PUBLIC_URL=https://pub-<hash>.r2.dev   # or your custom domain

# App
ENVIRONMENT=development
DEBUG=true

# Frontend base URL — used in password-reset email links
FRONTEND_URL=http://localhost:3000

# Email verification enforcement
#
# Enforcement is graduated, not a hard gate at registration. An unverified
# account keeps full access for EMAIL_VERIFICATION_GRACE_PERIOD_HOURS measured
# from users.created_at; after that it loses the *outbound* actions — swiping,
# sending messages, avatar generation — and gets HTTP 403 with
# detail.code = "email_verification_required". Reads stay open throughout, as do
# resend-verification, logout, profile edit and account deletion, so a user can
# see what they are about to lose and can still rescue themselves.
#
# ENFORCE_EMAIL_VERIFICATION is the operator kill switch; false makes the check a
# pass-through. It defaults to true because that is the correct posture and the
# grace window is what makes it survivable — but no email provider is wired yet
# (app/services/email.py prints to stdout), so if users cannot actually receive
# their verification link, turn this off rather than shipping a code change.
#
# Before enabling this on an existing database, grandfather in the accounts that
# registered before it existed, or they lose those actions having never been
# asked to verify:
#     python -m scripts.backfill_email_verification              # dry run
#     python -m scripts.backfill_email_verification --apply
ENFORCE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_GRACE_PERIOD_HOURS=72

# Sentry — optional; omitting disables error/performance monitoring
SENTRY_DSN=https://...@sentry.io/...

# Comma-separated frontend origins allowed by CORS. Defaults to empty, which is
# fine for local same-origin dev (Vite proxies /api), but a cross-origin deploy
# needs it: auth uses httpOnly cookies with allow_credentials=True, so the
# browser blocks every authenticated request when the origin isn't listed.
ALLOWED_ORIGINS=http://localhost:3000
