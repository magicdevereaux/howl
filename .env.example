# Database
DATABASE_URL=postgresql://howl:howl_dev@127.0.0.1:5433/howl

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — optional; enables DALL-E avatar image generation
OPENAI_API_KEY=sk-proj-...

# Cloudflare R2 — optional; enables persistent avatar storage (recommended for production)
# Without these, avatars are stored on the local filesystem and lost on Railway redeploys.
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=howl-avatars
R2_PUBLIC_URL=https://pub-<hash>.r2.dev   # or your custom domain

# App
ENVIRONMENT=development
DEBUG=true

# Frontend base URL — used in password-reset email links
FRONTEND_URL=http://localhost:3000

# Sentry — optional; omitting disables error/performance monitoring
SENTRY_DSN=https://...@sentry.io/...
